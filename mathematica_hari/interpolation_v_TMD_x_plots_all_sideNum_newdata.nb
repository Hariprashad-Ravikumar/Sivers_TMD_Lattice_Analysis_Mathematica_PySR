         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", " ", 
         RowBox[{"AxesLabel", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"x", ",", "None"}], "}"}]}]}], "]"}], ",", 
