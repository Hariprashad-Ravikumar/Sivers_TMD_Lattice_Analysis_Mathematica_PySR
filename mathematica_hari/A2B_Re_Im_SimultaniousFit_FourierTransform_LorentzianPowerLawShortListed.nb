Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "Helper", " ", "to", " ", "extract", " ", "list", " ", "from", 
    " ", "Jackknife", " ", "object"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GiveListfromJK", "[", "JK_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"JK", "/.", " ", 
         RowBox[{"JacknifeSamples", "->", "List"}]}], "]"}]}], "]"}]}], ";"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Parameters"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"targetPL", "=", 
     RowBox[{"-", "4"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"targetA", "=", "A12B"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"targetbNum", "=", "odd"}], ";", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "Assuming", " ", "odd", " ", "based", " ", "on", " ", "your", " ", 
       "snippet"}], ",", 
      RowBox[{"adjust", " ", "if", " ", "needed"}]}], "*)"}], 
    RowBox[{"(*", 
     RowBox[{
     "Initialize", " ", "an", " ", "empty", " ", "list", " ", "to", " ", 
      "store", " ", "all", " ", "formatted", " ", "rows"}], "*)"}], 
    RowBox[{"exportData", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "Loop", " ", "through", " ", "etav", " ", "from", " ", "0", 
     " ", "to", " ", "10"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"etaVal", "=", "0"}], ",", 
      RowBox[{"etaVal", "<=", "10"}], ",", 
      RowBox[{"etaVal", "++"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "Query", " ", "the", " ", "database", " ", "for", " ", "the", " ", 
        "current", " ", "eta"}], "*)"}], 
      RowBox[{
       RowBox[{"queryResult", "=", 
        RowBox[{
         RowBox[{"MemDBGet", "[", 
          RowBox[{"AmpDB", ",", 
           RowBox[{"MemDBSelect", "[", 
            RowBox[{"AmpDB", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"A", "->", "targetA"}], ",", 
               RowBox[{"PL", "->", "targetPL"}], ",", 
               RowBox[{"bNum", "->", "targetbNum"}], ",", 
               RowBox[{"etav", "->", "etaVal"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"etav", ",", "bL", ",", "bT", ",", "data"}], "}"}]}], 
          "]"}], "//", "Union"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Process", " ", "each", " ", "resulting", " ", "row"}], 
        "*)"}], 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", 
          RowBox[{"Length", "[", "queryResult", "]"}]}], ",", 
         RowBox[{"i", "++"}], ",", 
         RowBox[{
          RowBox[{"row", "=", 
           RowBox[{"queryResult", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"cEta", "=", 
           RowBox[{"row", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"cbL", "=", 
           RowBox[{"row", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"cbT", "=", 
           RowBox[{"row", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"jkData", "=", 
           RowBox[{"row", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Extract", " ", "samples", " ", "and", " ", "take", " ", "the", 
            " ", "Imaginary", " ", "part", " ", "for", " ", "ImA12B"}], 
           "*)"}], 
          RowBox[{"samplesList", "=", 
           RowBox[{"GiveListfromJK", "[", "jkData", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Flatten", " ", "into", " ", "a", " ", "single", " ", 
            RowBox[{"list", ":", 
             RowBox[{"{", 
              RowBox[{
              "eta", ",", "bL", ",", "bT", ",", "s1", ",", "s2", ",", "...", 
               ",", "sN"}], "}"}]}]}], "*)"}], 
          RowBox[{"flatRow", "=", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"cEta", ",", "cbL", ",", "cbT"}], "}"}], ",", 
             "samplesList"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Append", " ", "to", " ", "main", " ", "data", " ", "table"}], 
           "*)"}], 
          RowBox[{"AppendTo", "[", 
           RowBox[{"exportData", ",", "flatRow"}], "]"}], ";"}]}], "]"}], 
       ";"}]}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "Export", " ", "to", " ", "HDF5"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Note", ":", 
     RowBox[{
     "Adjust", " ", "the", " ", "export", " ", "path", " ", "to", " ", 
      "match", " ", "your", " ", "remote", " ", "or", " ", "local", " ", 
