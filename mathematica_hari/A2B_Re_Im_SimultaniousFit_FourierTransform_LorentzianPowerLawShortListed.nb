Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PrintxImA2B", "[", 
     RowBox[{"ParaFitReA2B_", ",", " ", "P1_", ",", " ", "b2_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "LenPara", ",", "fourieReA2Bxforplot", ",", " ", "fourierREA2Bforx", 
        ",", " ", "II", ",", " ", "bsqJK", ",", " ", "aReA2B", ",", " ", 
        "dReA2B", ",", " ", "cReA2B", ",", " ", "jReA2B", ",", " ", 
        "fourierImA2B", ",", " ", "PlotfourieReA2Bx"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"LenPara", " ", "=", " ", 
        RowBox[{"Length", "[", "ParaFitReA2B", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"II", " ", "=", " ", 
        RowBox[{
         RowBox[{"ParaFitReA2B", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "/", 
         RowBox[{"ParaFitReA2B", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], " ", ";", "\[IndentingNewLine]", 
       RowBox[{"aReA2B", " ", "=", " ", 
        RowBox[{
         RowBox[{"ParaFitReA2B", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "/", "P1"}]}], " ", ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dReA2B", "=", 
        RowBox[{"II", "+", 
         RowBox[{
          RowBox[{"ParaFitReA2B", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "*", "b2"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"cReA2B", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"ParaFitReA2B", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"P1", "^", "2"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"jReA2B", " ", "=", " ", 
        RowBox[{"ParaFitReA2B", "[", 
         RowBox[{"[", 
          RowBox[{"LenPara", "-", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"fourierImA2B", "[", 
         RowBox[{"x_", ",", " ", 
          RowBox[{"{", 
           RowBox[{"a_", ",", "d_", ",", "c_", ",", "j_"}], "}"}]}], "]"}], 
        " ", ":=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"1", "-", "j"}], ")"}]}], " ", "a", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"c", "/", "d"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"1", "/", "4"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "3"}], "-", 
                RowBox[{"2", " ", "j"}]}], ")"}]}], ")"}]}], " ", 
           RowBox[{"d", "^", 
            RowBox[{"-", "j"}]}], " ", "x", " ", 
           RowBox[{
            RowBox[{"Abs", "[", "x", "]"}], "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"(", 
                RowBox[{"3", "/", "2"}], ")"}]}], "+", "j"}], ")"}]}], " ", 
           RowBox[{"BesselK", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"3", "/", "2"}], "-", "j"}], ",", 
             RowBox[{
              RowBox[{"Sqrt", "[", 
               RowBox[{"d", "/", "c"}], "]"}], " ", 
              RowBox[{"Abs", "[", "x", "]"}]}]}], "]"}]}], ")"}], "/", 
         RowBox[{"Gamma", "[", "j", "]"}]}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"fourieReA2Bxforplot", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"fourierREA2Bforx", "=", 
           RowBox[{"modelfitJackkifex", "[", 
            RowBox[{"fourierImA2B", ",", 
             RowBox[{"{", 
              RowBox[{"aReA2B", ",", "dReA2B", ",", "cReA2B", ",", "jReA2B"}],
               "}"}], ",", " ", "x"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"fourieReA2Bxforplot", ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "fourierREA2Bforx"}], "}"}]}], "]"}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "1"}], ",", "1", ",", " ", "0.005"}], "}"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"PlotfourieReA2Bx", "=", " ", 
        RowBox[{"ErrorListPlot", "[", 
         RowBox[{
          RowBox[{"MakeErrBars", "[", "fourieReA2Bxforplot", "]"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{
             TemplateBox[<|"boxes" -> FormBox[
