 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"JackknifeFit3D", "[", 
     RowBox[{
     "xyJKf_", ",", "model_", ",", "para_", ",", "vari_", ",", " ", 
      "modelFnName_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "numFs", ",", "fitParamsForFj", ",", "fitParamsList", ",", 
        "paramLists", ",", "jackknifeResults", ",", "DoF", ",", " ", 
        "chisquare", ",", " ", "observed", ",", " ", "expected", ",", " ", 
        "chisquareperDoF"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"numFs", "=", 
        RowBox[{"Length", "[", 
         RowBox[{"xyJKf", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "3"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WeightList", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"\[CurlyEpsilon]", "=", 
           RowBox[{"10", "^", 
            RowBox[{"-", "6"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"\[Sigma]", "=", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"MakeErrBars", "[", 
                 RowBox[{"{", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", 
                    RowBox[{
                    RowBox[{"xyJKf", "[", 
                    RowBox[{"[", "ii", "]"}], "]"}], "[", 
                    RowBox[{"[", "3", "]"}], "]"}]}], "}"}], "}"}], "]"}], 
                "[", 
                RowBox[{"[", "1", "]"}], "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], ")"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"WeightList", ",", 
            RowBox[{"1", "/", 
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"\[Sigma]", ",", "\[CurlyEpsilon]"}], "]"}], "^", 
              "2"}]}]}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"ii", ",", " ", 
           RowBox[{"Length", "[", "xyJKf", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Function", " ", "to", " ", "extract", " ", "j"}], "-", 
