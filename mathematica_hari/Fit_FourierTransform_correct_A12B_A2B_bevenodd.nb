Cell[BoxData[{
 RowBox[{
  RowBox[{"PlotAbLfordiffbLbT", "[", 
   RowBox[{
   "ampname_", ",", "P1_", ",", " ", "etavalue_", ",", " ", "bnum_", ",", " ",
     "Nnum_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
      RowBox[{"Nnum", " ", "ampname"}], ",", 
      "\"\< => \!\(\*TemplateBox[<|\"boxes\" -> FormBox[
SubscriptBox[
StyleBox[\"P\", \"TI\"], 
StyleBox[\"L\", \"TI\"]], TraditionalForm], \"errors\" -> {}, \"input\" -> \
\"P_{L}\", \"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\"]\) = \>\"", ",", 
      "P1", ",", "\"\< ,eta = \>\"", ",", " ", "etavalue"}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"bTlist", "=", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"MemDBGet", "[", 
       RowBox[{"AmpDB", ",", 
        RowBox[{"MemDBSelect", "[", 
         RowBox[{"AmpDB", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"A", "->", "ampname"}], ",", 
