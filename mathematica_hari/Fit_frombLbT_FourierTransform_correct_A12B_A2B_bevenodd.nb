Cell[BoxData[{
 RowBox[{
  RowBox[{"PlotAbLfordiffbLbT", "[", 
   RowBox[{
   "ampname_", ",", "P1_", ",", " ", "etavalue_", ",", " ", "bnum_", ",", " ",
     "Nnum_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
      RowBox[{"Nnum", " ", "ampname"}], ",", 
      "\"\< => \!\(\*TemplateBox[<|\"boxes\" -> FormBox[
SubscriptBox[
StyleBox[\"P\", \"TI\"], 
StyleBox[\"L\", \"TI\"]], TraditionalForm], \"errors\" -> {}, \"input\" -> \
\"P_{L}\", \"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\"]\) = \>\"", ",", 
      "P1", ",", "\"\< ,eta = \>\"", ",", " ", "etavalue"}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"bTlist", "=", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"MemDBGet", "[", 
       RowBox[{"AmpDB", ",", 
        RowBox[{"MemDBSelect", "[", 
         RowBox[{"AmpDB", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"A", "->", "ampname"}], ",", 
            RowBox[{"PL", "->", "P1"}], ",", 
            RowBox[{"etav", "->", "etavalue"}], ",", " ", 
            RowBox[{"bNum", "->", "bnum"}]}], "}"}]}], "]"}], ",", "bT"}], 
       "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"bLlist", "=", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"MemDBGet", "[", 
       RowBox[{"AmpDB", ",", 
        RowBox[{"MemDBSelect", "[", 
         RowBox[{"AmpDB", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"A", "->", "ampname"}], ",", 
            RowBox[{"PL", "->", "P1"}], ",", 
            RowBox[{"etav", "->", "etavalue"}], ",", " ", 
            RowBox[{"bNum", "->", "bnum"}]}], "}"}]}], "]"}], ",", "bL"}], 
       "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"PlotbLforDiffbTList", "=", 
     RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"bLAmp", "=", 
        RowBox[{"MemDBGet", "[", 
         RowBox[{"AmpDB", ",", 
          RowBox[{"MemDBSelect", "[", 
           RowBox[{"AmpDB", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"A", "->", "ampname"}], ",", 
              RowBox[{"PL", "->", "P1"}], ",", 
              RowBox[{"etav", "->", "etavalue"}], ",", 
              RowBox[{"bT", "->", "bTi"}], ",", " ", 
              RowBox[{"bNum", "->", "bnum"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"bL", ",", "data"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"PlotbLforDiffbTList", ",", "bLAmp"}], "]"}], ";"}], 
      "\[IndentingNewLine]", " ", ",", 
      RowBox[{"{", 
       RowBox[{"bTi", ",", "bTlist"}], "}"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotbL", "=", " ", 
     RowBox[{"ErrorListPlot", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"MakeErrBars", "[", 
          RowBox[{"PlotbLforDiffbTList", "[", 
           RowBox[{"[", "bTi", "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"bTi", ",", " ", 
           RowBox[{"Length", "[", "bTlist", "]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
          TemplateBox[<|"boxes" -> FormBox[
              SubscriptBox[
               StyleBox["b", "TI"], 
               StyleBox["L", "TI"]], TraditionalForm], "errors" -> {}, 
            "input" -> "b_{L}", "state" -> "Boxes"|>,
           "TeXAssistantTemplate"], ",", " ", 
          RowBox[{"Nnum", " ", "ampname"}]}], " ", "}"}]}], ",", " ", 
       RowBox[{"Frame", "\[Rule]", "True"}], " ", ",", 
       RowBox[{"PlotRange", "->", "Full"}], ",", 
       RowBox[{"PlotLegends", "\[Rule]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
SubscriptBox[
StyleBox[\"b\", \"TI\"], 
StyleBox[\"T\", \"TI\"]], TraditionalForm], \"errors\" -> {}, \"input\" -> \
\"b_{T}\", \"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\"]\) = \>\"", "<>", 
