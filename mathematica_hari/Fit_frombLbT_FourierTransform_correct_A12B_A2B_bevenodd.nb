 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chisqOEsigmasq", "[", 
     RowBox[{"O_", ",", " ", "E_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "OEsigmasq", ",", " ", "Omean", ",", "Emean", ",", " ", "Esigmasq", 
        ",", " ", "Osigmasq", ",", " ", "sigmasqTotal"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Omean", "=", 
        RowBox[{"meanfromJK", "[", "O", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Emean", "=", 
        RowBox[{"meanfromJK", "[", "E", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Esigmasq", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"MakeErrBars", "[", 
               RowBox[{"{", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "E"}], "}"}], "}"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], ")"}], "^", "2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Osigmasq", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"MakeErrBars", "[", 
               RowBox[{"{", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "O"}], "}"}], "}"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], ")"}], "^", "2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sigmasqTotal", " ", "=", " ", 
        RowBox[{"Esigmasq", "+", "Osigmasq"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"OEsigmasq", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"sigmasqTotal", "==", "0"}], ",", "0", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"Omean", "-", "Emean"}], ")"}], "^", "2"}], ")"}], "/", 
           "Esigmasq"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "OEsigmasq"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"JackknifeFit3D", "[", 
    RowBox[{
    "xyJKf_", ",", "model_", ",", "para_", ",", "vari_", ",", " ", 
     "modelFnName_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "numFs", ",", "fitParamsForFj", ",", "fitParamsList", ",", "paramLists",
        ",", "jackknifeResults", ",", "DoF", ",", " ", "chisquare", ",", " ", 
       "observed", ",", " ", "expected", ",", " ", "chisquareperDoF"}], "}"}],
      ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"numFs", "=", 
       RowBox[{"Length", "[", 
        RowBox[{"xyJKf", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "3"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Function", " ", "to", " ", "extract", " ", "j"}], "-", 
        RowBox[{
        "th", " ", "f", " ", "values", " ", "and", " ", "fit", " ", 
         "them"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fitParamsForFj", "[", "j_", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"data", ",", "fit"}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"data", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", 
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{"3", ",", "j"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
            "xyJKf"}]}], ";", 
          RowBox[{"(*", 
           RowBox[{"Extract", " ", "f_j", " ", "values"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"fit", "=", 
           RowBox[{"NonlinearModelFit", "[", 
            RowBox[{"data", ",", "model", ",", "para", ",", "vari", ",", 
             RowBox[{"Method", "->", "\"\<LevenbergMarquardt\>\""}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], " ", 
        RowBox[{"(*", 
         RowBox[{"Extract", " ", "fitted", " ", "parameters"}], "*)"}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Compute", " ", "fit", " ", "parameters", " ", "for", " ", "each", " ",
         "f_j"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"fitParamsList", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"fitParamsForFj", "[", "j", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "numFs"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"jackknifeResults", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"JacknifeSamples", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"para", "[", 
             RowBox[{"[", "pa", "]"}], "]"}], "/.", " ", "fitParamsList"}], 
           ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"pa", ",", 
           RowBox[{"Length", "[", "para", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"DoF", "=", 
       RowBox[{"Length", "[", "xyJKf", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"chisquare", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"observed", " ", "=", " ", 
          RowBox[{"modelfitJackkife", "[", 
           RowBox[{"modelFnName", ",", " ", "jackknifeResults", ",", " ", 
            RowBox[{
             RowBox[{"xyJKf", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"xyJKf", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"expected", "=", " ", 
          RowBox[{
           RowBox[{"xyJKf", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"chisquare", " ", "=", " ", 
          RowBox[{"chisquare", " ", "+", " ", 
           RowBox[{"chisqOEsigmasq", "[", 
            RowBox[{"observed", ",", " ", "expected"}], "]"}]}]}], ";"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "DoF"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"chisquareperDoF", "=", 
       RowBox[{"chisquare", "/", 
        RowBox[{"(", 
         RowBox[{"DoF", "-", "3"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"FitParameters", "->", "jackknifeResults"}], ",", " ", 
        RowBox[{"chisquareDoF", "->", "chisquareperDoF"}]}], "}"}]}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]"}], "Input",
