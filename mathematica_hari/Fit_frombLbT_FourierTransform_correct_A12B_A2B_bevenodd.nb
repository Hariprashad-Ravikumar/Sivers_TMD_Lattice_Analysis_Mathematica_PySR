Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"modelfitJackkifband", "[", 
    RowBox[{
    "model_", ",", " ", "fitParams_", ",", "fixedVare_", ",", " ", "x_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "numFs", ",", " ", "modelvaluej", ",", "modelvalue", ",", " ", 
       "jackknifeResults"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"numFs", "=", 
       RowBox[{"Length", "[", 
        RowBox[{"fitParams", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{
       RowBox[{"modelvaluej", "[", "j_", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "datafitParams", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"datafitParams", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"fitParams", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", 
              RowBox[{"[", "j", "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"fitParams", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "[", 
              RowBox[{"[", "j", "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"fitParams", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"model", "[", 
           RowBox[{"x", ",", " ", "fixedVare", ",", "datafitParams"}], 
           "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"modelvalue", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"modelvaluej", "[", "j", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "numFs"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"jackknifeResults", "=", 
       RowBox[{"JacknifeSamples", "@@", 
        RowBox[{"(", "modelvalue", ")"}]}]}], ";", "\[IndentingNewLine]", 
      "jackknifeResults"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modelsechfit", "[", 
    RowBox[{"x1_", ",", "x2_", ",", 
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"a", "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "b"}], "*", 
      RowBox[{"x1", "^", "2"}]}], "]"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "c"}], "*", 
      RowBox[{"x2", "^", "2"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FitAfordiffBPbbsq", "[", 
