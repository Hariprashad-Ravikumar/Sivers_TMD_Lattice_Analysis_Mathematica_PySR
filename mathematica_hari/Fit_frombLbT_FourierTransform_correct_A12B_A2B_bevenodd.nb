   "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dataforfit", " ", "=", " ", 
     RowBox[{"MemDBGet", "[", 
      RowBox[{"AmpDB", ",", 
       RowBox[{"MemDBSelect", "[", 
        RowBox[{"AmpDB", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"A", "->", "ampname"}], ",", 
           RowBox[{"PL", "->", "P1"}], ",", 
           RowBox[{"etav", "->", "etavalue"}], ",", " ", 
           RowBox[{"bNum", "->", "even"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"bL", ",", " ", "bT", ",", "data"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"fitJK", " ", "=", 
     RowBox[{"JackknifeFit3D", "[", 
      RowBox[{"dataforfit", ",", 
       RowBox[{"modelfit", "[", 
        RowBox[{"bL", ",", "bT", ",", 
