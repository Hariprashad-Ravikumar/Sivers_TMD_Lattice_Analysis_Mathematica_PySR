 RowBox[{
  RowBox[{
   RowBox[{"modelfitJackkife", "[", 
    RowBox[{
    "model_", ",", " ", "fitParams_", ",", " ", "x_", ",", " ", "y_"}], "]"}],
    ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "numFs", ",", " ", "modelvaluej", ",", "modelvalue", ",", " ", 
       "jackknifeResults"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"numFs", "=", 
       RowBox[{"Length", "[", 
        RowBox[{"fitParams", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{
       RowBox[{"modelvaluej", "[", "j_", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "datafitParams", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"datafitParams", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"fitParams", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", 
              RowBox[{"[", "j", "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"fitParams", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "[", 
              RowBox[{"[", "j", "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"fitParams", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"model", "[", 
           RowBox[{"x", ",", "y", ",", "datafitParams"}], "]"}]}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"modelvalue", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"modelvaluej", "[", "j", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "numFs"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"jackknifeResults", "=", 
       RowBox[{"JacknifeSamples", "@@", 
        RowBox[{"(", "modelvalue", ")"}]}]}], ";", "\[IndentingNewLine]", 
      "jackknifeResults"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"meanfromJK", "[", "JKvalue_", "]"}], ":=", 
