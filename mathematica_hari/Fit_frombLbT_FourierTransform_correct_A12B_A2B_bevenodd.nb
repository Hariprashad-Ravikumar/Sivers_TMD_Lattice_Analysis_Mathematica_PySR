        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
SubscriptBox[
StyleBox[\"b\", \"TI\"], 
StyleBox[\"T\", \"TI\"]], TraditionalForm], \"errors\" -> {}, \"input\" -> \
\"b_{T}\", \"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\"]\) = \>\"", "<>", 
