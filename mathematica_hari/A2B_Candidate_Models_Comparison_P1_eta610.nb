Notebook[{

Cell[CellGroupData[{
Cell["Candidate Model Comparison for Re \!\(\*SubscriptBox[OverscriptBox[\(A\), \(~\)], \(2  B\)]\) (\!\(\*SubscriptBox[\(P\), \(L\)]\) = -1, 6 \[LessEqual] \[Eta] \[LessEqual] 10, |\!\(\*OverscriptBox[\(b\), \(\[RightVector]\)]\)| \[GreaterEqual] 3a)", "Title",
 CellChangeTimes->{3.983730000000000*^9}],

Cell["This notebook systematically tests and compares candidate functional forms for the unpolarized transverse amplitude \!\(\*SubscriptBox[OverscriptBox[\(A\), \(~\)], \(2  B\)]\)\!\(\*SuperscriptBox[\(\  \), \(Re\)]\) from Gaussian baselines to Lorentzian Power-Law models with asymptotic \[Eta]-corrections. It computes \!\(\*SuperscriptBox[\(\[Chi]\), \(2\)]\)/DoF, AIC, and AICc with full Jackknife uncertainty resampling and exports publication-ready EPS/PDF tables.", "Text",
 CellChangeTimes->{3.983730000000000*^9}],

Cell[CellGroupData[{
Cell["1. Environment & Package Initialization", "Section",
 CellChangeTimes->{3.983730000000000*^9}],

Cell[BoxData[{
 RowBox[{"SetOptions", "[", 
  RowBox[{"$FrontEnd", ",", 
   RowBox[{"\"\<CommonDefaultFormatTypes\>\"", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Output\>\"", "\[Rule]", "StandardForm"}], "}"}]}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"basepath", "=", 
  RowBox[{
  "$HomeDirectory", "<>", 
   "\"\</sivers_TMD_PhD_project/mathematica_hari\>\""}]}], "\
\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"basepath", "<>", "\"\</output\>\""}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"includepath", "=", 
   RowBox[{"basepath", "<>", "\"\</include\>\""}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AppendTo", "[", 
   RowBox[{"$Path", ",", " ", "includepath"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<LatticeAnalysis`\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"<<", "\"\<LatticeAnalysis`\>\""}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$HistoryLength", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<FourierSeries`\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"lata", "=", "0.11403"}]}], "Input",
 CellLabel->"In[1]:=",
 CellChangeTimes->{3.983730000000000*^9}]
}, Open  ]],

Cell[CellGroupData[{
Cell["2. Load Lattice Database", "Section",
 CellChangeTimes->{3.983730000000000*^9}],

