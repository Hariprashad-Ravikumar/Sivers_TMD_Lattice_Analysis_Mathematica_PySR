    ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "numFs", ",", " ", "modelvaluej", ",", "modelvalue", ",", " ", 
       "jackknifeResults"}], "}"}], ",", "\[IndentingNewLine]", 
