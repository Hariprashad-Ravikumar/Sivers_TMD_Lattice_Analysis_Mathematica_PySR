 RowBox[{"AmpDB", "=", 
  RowBox[{"BIDATEXReader", "[", 
   RowBox[{"basepath", "<>", "\"\</../sivers_new/newDBforA12BA2B/db_Alleta_correct_try_A12B_A2B_bL_bT_bevenodd.bidatex\>\""}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:=",
