Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Helper", " ", "functions", " ", "to", " ", "safely", " ", "extract", " ", 
    "mean", " ", "and", " ", "uncertainty", " ", "from", " ", "Jackknife", 
    " ", "samples"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"meanJK", "[", "jk_", "]"}], ":=", 
     RowBox[{
      RowBox[{"MakeErrBars", "[", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", "jk"}], "}"}], "}"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"errJK", "[", "jk_", "]"}], ":=", 
     RowBox[{
      RowBox[{"MakeErrBars", "[", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", "jk"}], "}"}], "}"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2", ",", "1", ",", "2"}], "]"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"formatJK", "[", "jk_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", "e"}], "}"}], ",", 
       RowBox[{
        RowBox[{"m", "=", 
         RowBox[{"meanJK", "[", "jk", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"e", "=", 
         RowBox[{"errJK", "[", "jk", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{"m", ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", "3"}], "}"}]}], "]"}], "]"}], "<>", 
         "\"\<(\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"Round", "[", 
           RowBox[{"e", "*", 
            RowBox[{"10", "^", "3"}]}], "]"}], "]"}], "<>", "\"\<)\>\""}]}]}],
       "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LorentzianFitList", "[", 
      RowBox[{"bminForFit_", ",", "momL_", ",", 
       RowBox[{"etamin_", ":", "6"}], ",", 
       RowBox[{"etamax_", ":", "10"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "dataforfitA2B", ",", "fitJKA2B", ",", "fitParasA2B", ",", "stab", 
         ",", "chiA2B", ",", 
         RowBox[{"results", "=", 
          RowBox[{"{", "}"}]}], ",", "aVal", ",", "cVal", ",", "dVal", ",", 
         "jVal", ",", "stabVal"}], "}"}], ",", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"modelfitA2B", "[", 
             RowBox[{"x1_", ",", "x2_", ",", "x3_", ",", 
              RowBox[{"{", 
               RowBox[{"a_", ",", "c_", ",", "d_", ",", "j_"}], "}"}]}], 
             "]"}], ":=", 
            RowBox[{"a", "/", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "+", 
                RowBox[{"c", "*", 
                 RowBox[{"x2", "^", "2"}]}], "+", 
                RowBox[{"d", "*", 
                 RowBox[{"x3", "^", "2"}]}]}], ")"}], "^", "j"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"dataforfitA2B", "=", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"MemDBGet", "[", 
               RowBox[{"AmpDB", ",", 
                RowBox[{"MemDBSelect", "[", 
                 RowBox[{"AmpDB", ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"A", "->", "A2B"}], ",", 
                    RowBox[{"PL", "->", "momL"}], ",", 
                    RowBox[{"bNum", "->", "even"}], ",", 
                    RowBox[{"etav", "->", "etaForFit"}]}], "}"}]}], "]"}], 
                ",", 
                RowBox[{"{", 
                 RowBox[{"etav", ",", "bL", ",", "bT", ",", "data"}], "}"}]}],
                "]"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Sqrt", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], "+", 
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], "^", "2"}]}], "]"}], ">=",
                 "bminForFit"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "dataforfitA2B", "]"}], ">", "4"}], ",", 
             
             RowBox[{
              RowBox[{"fitJKA2B", "=", 
               RowBox[{"JackknifeFit4D", "[", 
                RowBox[{"dataforfitA2B", ",", 
                 RowBox[{"modelfitA2B", "[", 
                  RowBox[{"n", ",", "bL", ",", "bT", ",", 
                   RowBox[{"{", 
                    RowBox[{"a", ",", "c", ",", "d", ",", "j"}], "}"}]}], 
                  "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"a", ",", "5.0"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"c", ",", "0.1"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"d", ",", "0.05"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"j", ",", "2.0"}], "}"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"n", ",", "bL", ",", "bT"}], "}"}], ",", 
                 "modelfitA2B"}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"fitParasA2B", "=", 
               RowBox[{"FitParameters", "/.", " ", "fitJKA2B"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"chiA2B", "=", 
               RowBox[{"N", "[", 
                RowBox[{"chisquareDoF", "/.", " ", "fitJKA2B"}], "]"}]}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Compute", " ", "stability", " ", "parameter", " ", 
                RowBox[{"(", 
                 RowBox[{"c", "-", "d"}], ")"}]}], "*)"}], 
              RowBox[{"stab", "=", 
               RowBox[{
                RowBox[{"fitParasA2B", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "-", 
                RowBox[{"fitParasA2B", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "Format", " ", "values", " ", "into", " ", "clean", " ", 
                "strings"}], "*)"}], 
              RowBox[{"aVal", "=", 
               RowBox[{"formatJK", "[", 
                RowBox[{"fitParasA2B", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"cVal", "=", 
               RowBox[{"formatJK", "[", 
                RowBox[{"fitParasA2B", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"dVal", "=", 
               RowBox[{"formatJK", "[", 
                RowBox[{"fitParasA2B", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"jVal", "=", 
               RowBox[{"formatJK", "[", 
                RowBox[{"fitParasA2B", "[", 
                 RowBox[{"[", "4", "]"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"stabVal", "=", 
               RowBox[{"formatJK", "[", "stab", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"results", ",", 
                RowBox[{"{", 
                 RowBox[{"etaForFit", ",", 
                  RowBox[{
                  "\"\<{\>\"", "<>", "aVal", "<>", "\"\<, \>\"", "<>", "cVal",
                    "<>", "\"\<, \>\"", "<>", "dVal", "<>", "\"\<, \>\"", "<>",
                    "jVal", "<>", "\"\<}\>\""}], ",", "stabVal", ",", 
                  RowBox[{"NumberForm", "[", 
                   RowBox[{"chiA2B", ",", 
                    RowBox[{"{", 
                    RowBox[{"4", ",", "3"}], "}"}]}], "]"}]}], "}"}]}], "]"}],
               ";"}]}], "]"}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"etaForFit", ",", "etamin", ",", "etamax"}], "}"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<Lorentzian Fit for Re \
\\!\\(\\*SubscriptBox[OverscriptBox[\\(A\\), \\(~\\)], \\(2 B\\)]\\) at fixed \
\[Eta] (\>\"", ",", "etamin", ",", 
          "\"\< \[LessEqual] \[Eta] \[LessEqual] \>\"", ",", "etamax", ",", 
          "\"\<) & \\!\\(\\*SubscriptBox[\\(P\\), \\(L\\)]\\) = \>\"", ",", 
          "momL", ",", 
          "\"\<\\nCut: |\\!\\(\\*OverscriptBox[\\(b\\), \\(\[RightVector]\\)]\
\\)| \[GreaterEqual] \>\"", ",", "bminForFit", ",", "\"\<a\\n\>\""}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"TableForm", "[", 
         RowBox[{"results", ",", 
          RowBox[{"TableHeadings", "->", 
           RowBox[{"{", 
            RowBox[{"None", ",", 
             RowBox[{"{", 
              RowBox[{
              "\"\<\[Eta]\>\"", ",", "\"\<Parameters {a, c, d, j}\>\"", ",", 
               "\"\<Stability (c - d)\>\"", ",", 
               "\"\<\\!\\(\\*SuperscriptBox[\\(\[Chi]\\), \
\\(2\\)]\\)/DoF\>\""}], "}"}]}], "}"}]}], ",", 
          RowBox[{"TableSpacing", "->", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}]}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\n"}]}]], "Input",
