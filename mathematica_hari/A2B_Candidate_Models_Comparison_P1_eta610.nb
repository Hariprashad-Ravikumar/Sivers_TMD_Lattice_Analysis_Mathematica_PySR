Cell[CellGroupData[{
Cell["3. Jackknife & Information Criterion Fitting Engine", "Section",
 CellChangeTimes->{3.983730000000000*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chisqOEsigmasq", "[", 
    RowBox[{"O_", ",", "E_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Omean", ",", "Emean", ",", "Esigmasq", ",", "Osigmasq", ",", "sigmasqTotal", ",", "OEsigmasq"}], "}"}], ",", 
     RowBox[{
      RowBox[{"Omean", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"MakeErrBars", "[", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"1", ",", "O"}], "}"}], "}"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Emean", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"MakeErrBars", "[", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"1", ",", "E"}], "}"}], "}"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Esigmasq", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"MakeErrBars", "[", 
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{"1", ",", "E"}], "}"}], "}"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], ")"}], "^", "2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Osigmasq", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"MakeErrBars", "[", 
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{"1", ",", "O"}], "}"}], "}"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], ")"}], "^", "2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sigmasqTotal", "=", 
       RowBox[{"Esigmasq", "+", "Osigmasq"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"OEsigmasq", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"sigmasqTotal", "==", "0"}], ",", "0", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Omean", "-", "Emean"}], ")"}], "^", "2"}], "/", "sigmasqTotal"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      "OEsigmasq"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modelfitJackkifefor4D", "[", 
    RowBox[{"modelFnName_", ",", "fitParams_", ",", "x1_", ",", "x2_", ",", "x3_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"numFs", ",", "numParams", ",", "modelvaluej", ",", "modelvalue", ",", "jackknifeResults"}], "}"}], ",", 
     RowBox[{
      RowBox[{"numFs", "=", 
       RowBox[{"Length", "[", 
        RowBox[{"fitParams", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"numParams", "=", 
       RowBox[{"Length", "[", "fitParams", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"modelvaluej", "[", "j_", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "datafitParams", "}"}], ",", 
         RowBox[{
          RowBox[{"datafitParams", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"fitParams", "[", 
              RowBox[{"[", 
               RowBox[{"p", ",", "j"}], "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"p", ",", "numParams"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"modelFnName", "[", 
           RowBox[{"x1", ",", "x2", ",", "x3", ",", "datafitParams"}], "]"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"modelvalue", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"modelvaluej", "[", "j", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "numFs"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"jackknifeResults", "=", 
       RowBox[{"JacknifeSamples", "@@", "modelvalue"}]}], ";", "\[IndentingNewLine]", 
      "jackknifeResults"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"JackknifeFit4D", "[", 
    RowBox[{"nxyJKf_", ",", "model_", ",", "para_", ",", "vari_", ",", "modelFnName_", ",", 
     RowBox[{"init_", ":", "Automatic"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"numFs", ",", "fitParamsForFj", ",", "fitParamsList", ",", "jackknifeResults", ",", "n", ",", "k", ",", "chisquare", ",", "observed", ",", "expected", ",", "chisquareperDoF", ",", "AICvalue", ",", "AICcvalue", ",", "WeightList"}], "}"}], ",", 
     RowBox[{
      RowBox[{"numFs", "=", 
       RowBox[{"Length", "[", 
        RowBox[{"nxyJKf", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "4"}], "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"WeightList", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Sigma]", "=", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"MakeErrBars", "[", 
                  RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"1", ",", 
                    RowBox[{"nxyJKf", "[", 
                    RowBox[{"[", 
                    RowBox[{"ii", ",", "4"}], "]"}], "]"}]}], "}"}], "}"}], 
                  "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"1", "/", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"\[Sigma]", ",", 
               RowBox[{"10", "^", 
                RowBox[{"-", "6"}]}]}], "]"}], "^", "2"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"ii", ",", 
           RowBox[{"Length", "[", "nxyJKf", "]"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fitParamsForFj", "[", "j_", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"data", ",", "fit"}], "}"}], ",", 
         RowBox[{
          RowBox[{"data", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"row", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"row", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", 
               RowBox[{"row", "[", 
                RowBox[{"[", "3", "]"}], "]"}], ",", 
               RowBox[{"row", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", "j"}], "]"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"row", ",", "nxyJKf"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"fit", "=", 
           RowBox[{"NonlinearModelFit", "[", 
            RowBox[{"data", ",", "model", ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"init", "===", "Automatic"}], ",", "para", ",", "init"}], 
              "]"}], ",", "vari", ",", 
             RowBox[{"Weights", "\[Rule]", "WeightList"}], ",", 
             RowBox[{"Method", "\[Rule]", 
              RowBox[{"{", "\"\<LevenbergMarquardt\>\"", "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fitParamsList", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"fitParamsForFj", "[", "j", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "numFs"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"jackknifeResults", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"JacknifeSamples", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"para", "[", 
             RowBox[{"[", "pa", "]"}], "]"}], "/.", "fitParamsList"}], 
           ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"pa", ",", 
           RowBox[{"Length", "[", "para", "]"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "nxyJKf", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"chisquare", "=", 
       RowBox[{"Total", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"observed", "=", 
            RowBox[{"modelfitJackkifefor4D", "[", 
             RowBox[{"modelFnName", ",", "jackknifeResults", ",", 
              RowBox[{"nxyJKf", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"nxyJKf", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"nxyJKf", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "3"}], "]"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"expected", "=", 
            RowBox[{"nxyJKf", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "4"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"chisqOEsigmasq", "[", 
            RowBox[{"observed", ",", "expected"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"k", "=", 
       RowBox[{"Length", "[", "para", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"chisquareperDoF", "=", 
       RowBox[{"chisquare", "/", 
        RowBox[{"(", 
         RowBox[{"n", "-", "k"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"AICvalue", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", "*", "k"}], ")"}], "+", "chisquare"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"AICcvalue", "=", 
       RowBox[{"AICvalue", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "*", "k", "*", 
           RowBox[{"(", 
            RowBox[{"k", "+", "1"}], ")"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"n", "-", "k", "-", "1"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"FitParameters", "\[Rule]", "jackknifeResults"}], ",", 
        RowBox[{"chisquareDoF", "\[Rule]", "chisquareperDoF"}], ",", 
        RowBox[{"AIC", "\[Rule]", "AICvalue"}], ",", 
        RowBox[{"AICc", "\[Rule]", "AICcvalue"}]}], "}"}]}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]"}], "Input",
 CellLabel->"In[3]:=",
 CellChangeTimes->{3.983730000000000*^9}]
}, Open  ]],

Cell[CellGroupData[{
Cell["4. Candidate Model Progression & Systematic Comparison", "Section",
 CellChangeTimes->{3.983730000000000*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CompareCandidatesA2B", "[", 
    RowBox[{"bminForFit_", ",", "momL_", ",", "etamin_", ",", "etamax_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "dataforfitA2B", ",", "results", ",", "m1", ",", "fit1", ",", "m2", ",", 
       "fit2", ",", "m3", ",", "fit3", ",", "m4", ",", "fit4", ",", "m5", ",", 
       "fit5", ",", "m6", ",", "fit6", ",", "m7", ",", "fit7", ",", 
       "tableData", ",", "header", ",", "gridTable", ",", "titleText", ",", 
       "finalDisplay", ",", "outputThesisDir", ",", "outputCodeDir"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"results", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"dataforfitA2B", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"MemDBGet", "[", 
          RowBox[{"AmpDB", ",", 
           RowBox[{"MemDBSelect", "[", 
            RowBox[{"AmpDB", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"A", "\[Rule]", "A2B"}], ",", 
               RowBox[{"PL", "\[Rule]", "momL"}], ",", 
               RowBox[{"bNum", "\[Rule]", "even"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"etav", ",", "bL", ",", "bT", ",", "data"}], "}"}]}], 
          "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "\[GreaterEqual]", "etamin"}], "&&", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "\[LessEqual]", "etamax"}], "&&", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], "+", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "^", "2"}]}], "]"}], 
            "\[GreaterEqual]", "bminForFit"}]}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Filtered Data Points Count: \>\"", ",", 
        RowBox[{"Length", "[", "dataforfitA2B", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Model", " ", "1", ":", " ", 
        RowBox[{"Pure", " ", "Gaussian"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Fitting M1: Pure Gaussian...\>\"", "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"m1", "[", 
        RowBox[{"x1_", ",", "x2_", ",", "x3_", ",", 
         RowBox[{"{", 
          RowBox[{"a_", ",", "c_", ",", "d_", ",", "f_"}], "}"}]}], "]"}], ":=", 
       RowBox[{"a", "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "f"}], "*", "x1"}], "]"}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "c"}], "*", 
           RowBox[{"x2", "^", "2"}]}], "-", 
          RowBox[{"d", "*", 
           RowBox[{"x3", "^", "2"}]}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fit1", "=", 
       RowBox[{"JackknifeFit4D", "[", 
        RowBox[{"dataforfitA2B", ",", 
         RowBox[{"m1", "[", 
          RowBox[{"n", ",", "bL", ",", "bT", ",", 
           RowBox[{"{", 
            RowBox[{"a", ",", "c", ",", "d", ",", "f"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", "c", ",", "d", ",", "f"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "bL", ",", "bT"}], "}"}], ",", "m1", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", ",", "2.5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"c", ",", "0.05"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"d", ",", "0.05"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"f", ",", "0.4"}], "}"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"results", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<M1: Pure Gaussian\>\"", ",", 
          RowBox[{"HoldForm", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"a", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", "f"}], " ", "\[Eta]"}], "]"}]}], ")"}], " ", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "c"}], " ", 
               SubsuperscriptBox["b", "L", "2"]}], "-", 
              RowBox[{"d", " ", 
               SubsuperscriptBox["b", "T", "2"]}]}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
           "\"\<a\>\"", ",", "\"\<c\>\"", ",", "\"\<d\>\"", ",", 
            "\"\<f\>\""}], "}"}], ",", 
          RowBox[{"FitParameters", "/.", "fit1"}], ",", 
          RowBox[{"chisquareDoF", "/.", "fit1"}], ",", 
          RowBox[{"AIC", "/.", "fit1"}], ",", 
          RowBox[{"AICc", "/.", "fit1"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Model", " ", "2", ":", " ", 
        RowBox[{"Gaussian", " ", "with", " ", "eta", "^", "g"}]}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Fitting M2: Gaussian with \[Eta]^g...\>\"", "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"m2", "[", 
        RowBox[{"x1_", ",", "x2_", ",", "x3_", ",", 
         RowBox[{"{", 
          RowBox[{"a_", ",", "c_", ",", "d_", ",", "f_", ",", "g_"}], "}"}]}], 
        "]"}], ":=", 
       RowBox[{"a", "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "f"}], "*", "x1"}], "]"}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"d", "+", 
              RowBox[{"c", "*", 
               RowBox[{"(", 
                RowBox[{"x1", "^", "g"}], ")"}]}]}], ")"}]}], "*", 
           RowBox[{"x2", "^", "2"}]}], "-", 
          RowBox[{"d", "*", 
           RowBox[{"x3", "^", "2"}]}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fit2", "=", 
       RowBox[{"JackknifeFit4D", "[", 
        RowBox[{"dataforfitA2B", ",", 
         RowBox[{"m2", "[", 
          RowBox[{"n", ",", "bL", ",", "bT", ",", 
           RowBox[{"{", 
            RowBox[{"a", ",", "c", ",", "d", ",", "f", ",", "g"}], "}"}]}], 
          "]"}], ",", 
