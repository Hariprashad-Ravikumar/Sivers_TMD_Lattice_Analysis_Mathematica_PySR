(* Beginning of Notebook Content *)
Notebook[{
Cell["\<\
Candidate Model Comparison for Re \!\(\*SubscriptBox[OverscriptBox[\(A\), \(~\
\)], \(2 B\)]\) (\!\(\*SubscriptBox[\(P\), \(L\)]\) = -1, 6 \[LessEqual] \
\[Eta] \[LessEqual] 10, |\!\(\*OverscriptBox[\(b\), \(\[RightVector]\)]\)| \
\[GreaterEqual] 3a)\
\>", "Title"],

Cell["\<\
This notebook systematically tests and compares candidate functional forms \
for the unpolarized transverse amplitude \!\(\*SubscriptBox[OverscriptBox[\(A\
\), \(~\)], \(2 B\)]\)\!\(\*SuperscriptBox[\(  \), \(Re\)]\) from Gaussian \
baselines to Lorentzian Power-Law models with asymptotic \[Eta]-corrections. \
It computes \!\(\*SuperscriptBox[\(\[Chi]\), \(2\)]\)/DoF, AIC, and AICc with \
full Jackknife uncertainty resampling and exports publication-ready EPS/PDF \
tables.\
\>", "Text"],

Cell[CellGroupData[{

Cell["1. Environment & Package Initialization", "Section"],

Cell["\<\
SetOptions[$FrontEnd, \"CommonDefaultFormatTypes\" -> {\"Output\" -> \
StandardForm}];
basepath = $HomeDirectory <> \"/sivers_TMD_PhD_project/mathematica_hari\";
SetDirectory[basepath <> \"/output\"];
includepath = basepath <> \"/include\";
AppendTo[$Path, includepath];
Needs[\"LatticeAnalysis`\"];
<< \"LatticeAnalysis`\";
$HistoryLength = 0;
Needs[\"FourierSeries`\"];
lata = 0.11403;\
\>", "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Load Lattice Database", "Section"],

Cell["\<\
AmpDB = BIDATEXReader[basepath <> \
\"/../sivers_new/newDBforA12BA2B/db_Alleta_correct_try_A12B_A2B_bL_bT_\
bevenodd.bidatex\"];\
\>", "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Jackknife & Information Criterion Fitting Engine", "Section"],

Cell["\<\
chisqOEsigmasq[O_, E_] := Module[
  {Omean, Emean, Esigmasq, Osigmasq, sigmasqTotal, OEsigmasq},
  Omean = MakeErrBars[{{1, O}}][[1]][[1]][[2]];
  Emean = MakeErrBars[{{1, E}}][[1]][[1]][[2]];
  Esigmasq = (MakeErrBars[{{1, E}}][[1]][[2]][[1]][[2]])^2;
  Osigmasq = (MakeErrBars[{{1, O}}][[1]][[2]][[1]][[2]])^2;
  sigmasqTotal = Esigmasq + Osigmasq;
  OEsigmasq = If[sigmasqTotal == 0, 0, (Omean - Emean)^2 / sigmasqTotal];
  OEsigmasq
];

modelfitJackkifefor4D[modelFnName_, fitParams_, x1_, x2_, x3_] := Module[
  {numFs, numParams, modelvaluej, modelvalue, jackknifeResults},
  numFs = Length[fitParams[[1]]];
  numParams = Length[fitParams];
  modelvaluej[j_] := Module[{datafitParams},
    datafitParams = Table[fitParams[[p, j]], {p, numParams}];
    modelFnName[x1, x2, x3, datafitParams]
  ];
  modelvalue = Table[modelvaluej[j], {j, numFs}];
  jackknifeResults = JacknifeSamples @@ modelvalue;
  jackknifeResults
];

JackknifeFit4D[nxyJKf_, model_, para_, vari_, modelFnName_, init_: Automatic] \
:= Module[
  {numFs, fitParamsForFj, fitParamsList, jackknifeResults, n, k, chisquare, \
observed, expected, chisquareperDoF, AICvalue, AICcvalue, WeightList},
  numFs = Length[nxyJKf[[1, 4]]];
  WeightList = Table[
    With[{sigma = MakeErrBars[{{1, nxyJKf[[ii, 4]]}}][[1, 2, 1, 2]]},
      1 / Max[sigma, 10^-6]^2
    ],
    {ii, Length[nxyJKf]}
  ];
  fitParamsForFj[j_] := Module[{data, fit},
    data = Table[{row[[1]], row[[2]], row[[3]], row[[4, j]]}, {row, nxyJKf}];
    fit = NonlinearModelFit[data, model, If[init === Automatic, para, init], \
vari, Weights -> WeightList, Method -> {\"LevenbergMarquardt\"}];
    fit[\"BestFitParameters\"]
  ];
  fitParamsList = Table[fitParamsForFj[j], {j, numFs}];
  jackknifeResults = Table[
    JacknifeSamples @@ (para[[pa]] /. fitParamsList),
    {pa, Length[para]}
  ];
  n = Length[nxyJKf];
  chisquare = Total[Table[
    observed = modelfitJackkifefor4D[modelFnName, jackknifeResults, \
nxyJKf[[i, 1]], nxyJKf[[i, 2]], nxyJKf[[i, 3]]];
    expected = nxyJKf[[i, 4]];
    chisqOEsigmasq[observed, expected],
    {i, n}
  ]];
  k = Length[para];
  chisquareperDoF = chisquare / (n - k);
  AICvalue = (2 * k) + chisquare;
  AICcvalue = AICvalue + (2 * k * (k + 1)) / (n - k - 1);
  {FitParameters -> jackknifeResults, chisquareDoF -> chisquareperDoF, AIC -> \
AICvalue, AICc -> AICcvalue}
];\
\>", "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Candidate Model Progression & Systematic Comparison", "Section"],

Cell["\<\
CompareCandidatesA2B[bminForFit_, momL_, etamin_, etamax_] := Module[
  {dataforfitA2B, results = {}, m1, fit1, m2, fit2, m3, fit3, m4, fit4, m5, \
fit5, m6, fit6, m7, fit7, tableData, header, gridTable, titleText, \
finalDisplay, outputThesisDir, outputCodeDir},
  
  dataforfitA2B = Select[
    MemDBGet[AmpDB, MemDBSelect[AmpDB, {A -> A2B, PL -> momL, bNum -> even}], \
{etav, bL, bT, data}],
    (#[[1]] >= etamin && #[[1]] <= etamax && Sqrt[#[[2]]^2 + #[[3]]^2] >= \
bminForFit) &
  ];
  Print[\"Filtered Data Points Count: \", Length[dataforfitA2B]];
  
  (* M1: Pure Gaussian *)
  Print[\"Fitting M1: Pure Gaussian...\"];
  m1[x1_, x2_, x3_, {a_, c_, d_, f_}] := a * Exp[-f * x1] * Exp[-c * x2^2 - d \
* x3^2];
  fit1 = JackknifeFit4D[dataforfitA2B, m1[n, bL, bT, {a, c, d, f}], {a, c, d, \
f}, {n, bL, bT}, m1, {{a, 2.5}, {c, 0.05}, {d, 0.05}, {f, 0.4}}];
  AppendTo[results, {\"M1: Pure Gaussian\", (a * Exp[-f * \[Eta]]) * Exp[-c * \
Subsuperscript[b, L, 2] - d * Subsuperscript[b, T, 2]], {\"a\", \"c\", \"d\", \
\"f\"}, FitParameters /. fit1, chisquareDoF /. fit1, AIC /. fit1, AICc /. \
fit1}];
  
  (* M2: Gaussian with eta^g *)
  Print[\"Fitting M2: Gaussian with \[Eta]^g...\"];
  m2[x1_, x2_, x3_, {a_, c_, d_, f_, g_}] := a * Exp[-f * x1] * Exp[-(d + c * \
(x1^g)) * x2^2 - d * x3^2];
  fit2 = JackknifeFit4D[dataforfitA2B, m2[n, bL, bT, {a, c, d, f, g}], {a, c, \
d, f, g}, {n, bL, bT}, m2, {{a, 2.5}, {c, 0.01}, {d, 0.05}, {f, 0.4}, {g, \
0.5}}];
  AppendTo[results, {\"M2: Gaussian + \!\(\*SuperscriptBox[\(\[Eta]\), \(g\)]\
\)\", (a * Exp[-f * \[Eta]]) * Exp[-(d + c * (\[Eta]^g)) * Subsuperscript[b, \
L, 2] - d * Subsuperscript[b, T, 2]], {\"a\", \"c\", \"d\", \"f\", \"g\"}, \
FitParameters /. fit2, chisquareDoF /. fit2, AIC /. fit2, AICc /. fit2}];
  
  (* M3: Lorentzian j=1 *)
  Print[\"Fitting M3: Lorentzian (j=1)...\"];
  m3[x1_, x2_, x3_, {a_, c_, d_, f_}] := (a * Exp[-f * x1]) / (1 + c * x2^2 + \
d * x3^2);
  fit3 = JackknifeFit4D[dataforfitA2B, m3[n, bL, bT, {a, c, d, f}], {a, c, d, \
f}, {n, bL, bT}, m3, {{a, 3.0}, {c, 0.05}, {d, 0.05}, {f, 0.4}}];
  AppendTo[results, {\"M3: Lorentzian (j=1)\", (a * Exp[-f * \[Eta]]) / (1 + \
c * Subsuperscript[b, L, 2] + d * Subsuperscript[b, T, 2]), {\"a\", \"c\", \
\"d\", \"f\"}, FitParameters /. fit3, chisquareDoF /. fit3, AIC /. fit3, AICc \
/. fit3}];
  
  (* M4: Lorentzian Power-Law *)
  Print[\"Fitting M4: Lorentzian Power-Law...\"];
  m4[x1_, x2_, x3_, {a_, c_, d_, f_, j_}] := (a * Exp[-f * x1]) / (1 + c * \
x2^2 + d * x3^2)^j;
  fit4 = JackknifeFit4D[dataforfitA2B, m4[n, bL, bT, {a, c, d, f, j}], {a, c, \
d, f, j}, {n, bL, bT}, m4, {{a, 4.0}, {c, 0.05}, {d, 0.05}, {f, 0.45}, {j, \
2.0}}];
  AppendTo[results, {\"M4: Lorentzian Power-Law\", (a * Exp[-f * \[Eta]]) / \
(1 + c * Subsuperscript[b, L, 2] + d * Subsuperscript[b, T, 2])^j, {\"a\", \
\"c\", \"d\", \"f\", \"j\"}, FitParameters /. fit4, chisquareDoF /. fit4, AIC \
/. fit4, AICc /. fit4}];
  
  (* M5: Power-Law with eta^g *)
  Print[\"Fitting M5: Power-Law with \[Eta]^g...\"];
  m5[x1_, x2_, x3_, {a_, c_, d_, f_, g_, j_}] := (a * Exp[-f * x1]) / (1 + c \
* (x1^g) * x2^2 + d * x3^2)^j;
  fit5 = JackknifeFit4D[dataforfitA2B, m5[n, bL, bT, {a, c, d, f, g, j}], {a, \
c, d, f, g, j}, {n, bL, bT}, m5, {{a, 5.0}, {c, 0.03}, {d, 0.08}, {f, 0.5}, \
{g, 0.5}, {j, 2.1}}];
  AppendTo[results, {\"M5: Power-Law + \!\(\*SuperscriptBox[\(\[Eta]\), \
\(g\)]\)\", (a * Exp[-f * \[Eta]]) / (1 + c * (\[Eta]^g) * Subsuperscript[b, \
L, 2] + d * Subsuperscript[b, T, 2])^j, {\"a\", \"c\", \"d\", \"f\", \"g\", \
\"j\"}, FitParameters /. fit5, chisquareDoF /. fit5, AIC /. fit5, AICc /. \
fit5}];
  
  (* M6: Asymptotic 1/eta *)
  Print[\"Fitting M6: Asymptotic (1/\[Eta])...\"];
  m6[x1_, x2_, x3_, {a_, c_, d_, f_, k_, j_}] := (a * Exp[-f * x1]) / (1 + (d \
+ c * (1 - k / x1)) * x2^2 + d * x3^2)^j;
  fit6 = JackknifeFit4D[dataforfitA2B, m6[n, bL, bT, {a, c, d, f, k, j}], {a, \
c, d, f, k, j}, {n, bL, bT}, m6, {{a, 5.5}, {c, 0.04}, {d, 0.09}, {f, 0.5}, \
{k, 6.0}, {j, 2.1}}];
  AppendTo[results, {\"M6: Asymptotic (1/\[Eta])\", (a * Exp[-f * \[Eta]]) / \
(1 + (d + c * (1 - k / \[Eta])) * Subsuperscript[b, L, 2] + d * \
Subsuperscript[b, T, 2])^j, {\"a\", \"c\", \"d\", \"f\", \"k\", \"j\"}, \
FitParameters /. fit6, chisquareDoF /. fit6, AIC /. fit6, AICc /. fit6}];
  
  (* M7: Asymptotic 1/eta + 1/eta^2 *)
  Print[\"Fitting M7: Asymptotic (1/\[Eta] + 1/\[Eta]^2)...\"];
  m7[x1_, x2_, x3_, {a_, c_, d_, f_, k1_, k2_, j_}] := (a * Exp[-f * x1]) / \
(1 + (d + c * (1 - k1 / x1 - k2 / (x1^2))) * x2^2 + d * x3^2)^j;
  fit7 = JackknifeFit4D[dataforfitA2B, m7[n, bL, bT, {a, c, d, f, k1, k2, \
j}], {a, c, d, f, k1, k2, j}, {n, bL, bT}, m7, {{a, 5.5}, {c, 0.04}, {d, \
0.09}, {f, 0.5}, {k1, 5.0}, {k2, 5.0}, {j, 2.1}}];
  AppendTo[results, {\"M7: Asymptotic (1/\[Eta] + 1/\!\(\*SuperscriptBox[\(\
\[Eta]\), \(2\)]\))\", (a * Exp[-f * \[Eta]]) / (1 + (d + c * (1 - k1 / \
\[Eta] - k2 / (\[Eta]^2))) * Subsuperscript[b, L, 2] + d * Subsuperscript[b, \
T, 2])^j, {\"a\", \"c\", \"d\", \"f\", \"k1\", \"k2\", \"j\"}, FitParameters \
/. fit7, chisquareDoF /. fit7, AIC /. fit7, AICc /. fit7}];
  
  (* Format Table *)
  tableData = Table[{
    Style[r[[1]], Bold, 11],
    TraditionalForm[r[[2]]],
    OutputForm[TableForm[Partition[r[[3]], UpTo[2]]]],
    OutputForm[TableForm[Partition[r[[4]], UpTo[2]]]],
    NumberForm[r[[5]], {5, 3}],
    NumberForm[r[[6]], {6, 2}],
    NumberForm[r[[7]], {6, 2}]
  }, {r, results}];
  
  header = {
    Style[\"Model Candidate\", Bold, 12],
    Style[\"Ansatz Expression\", Bold, 12],
    Style[\"Params\", Bold, 12],
    Style[\"Fitted Values (Jackknife)\", Bold, 12],
    Style[\"\!\(\*SuperscriptBox[\(\[Chi]\), \(2\)]\)/DoF\", Bold, 12],
    Style[\"AIC\", Bold, 12],
    Style[\"AICc\", Bold, 12]
  };
  
  gridTable = Grid[Prepend[tableData, header], Frame -> All, Background -> \
{None, {RGBColor[0.92, 0.95, 1.0], None}}, Alignment -> {Center, Center}, \
ItemSize -> Full, Spacings -> {1.5, 1.2}, Dividers -> {All, {True, True, \
Sequence @@ Table[True, {Length[results]}], True}}];
  titleText = Style[\"Candidate Model Fits & Information Criterion for \
\!\(\*SubscriptBox[OverscriptBox[\(A\), \(~\)], \(2  \
B\)]\)\!\(\*SuperscriptBox[\(  \), \(Re\)]\)\\n(\!\(\*SubscriptBox[\(P\), \(L\
\)]\) = \" <> ToString[momL] <> \",  \" <> ToString[etamin] <> \" \
\[LessEqual] \[Eta] \[LessEqual] \" <> ToString[etamax] <> \",  \
|\!\(\*OverscriptBox[\(b\), \(\[RightVector]\)]\)| \[GreaterEqual] \" <> \
ToString[bminForFit] <> \"a)\", Bold, 14, FontFamily -> \"Helvetica\"];
  finalDisplay = Column[{titleText, Spacer[10], gridTable}, Alignment -> \
Center];
  
  outputThesisDir = \
\"/Users/hariprashadravikumar/Lattice_QCD_TMD_PhD/Lattice-QCD-calculations-of-\
x-dependence-of-Sivers-TMD-Hariprashad-Ravikumar-NMSU-PhD-Thesis/Gaussian_\
type_fit_Real_A2B\";
  outputCodeDir = basepath <> \"/output\";
  
  Export[outputThesisDir <> \"/FitList_eta678910_p-1.eps\", finalDisplay, \
\"EPS\"];
  Export[outputThesisDir <> \"/FitList_eta678910_p-1.pdf\", finalDisplay, \
\"PDF\"];
  Export[outputCodeDir <> \"/FitList_eta678910_p-1.eps\", finalDisplay, \"EPS\
\"];
  Export[outputCodeDir <> \"/FitList_eta678910_p-1.pdf\", finalDisplay, \"PDF\
\"];
  Export[outputCodeDir <> \"/FitList_eta678910_p-1.png\", finalDisplay, \"PNG\
\", ImageResolution -> 300];
  
  Print[\"Graphics successfully exported to Thesis and Code directories!\"];
  Return[finalDisplay];
];\
\>", "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Evaluate Candidate Fits for P_L = -1, \[Eta] \[Element] [6, 10], b \
\[GreaterEqual] 3a", "Subsection"],

Cell["CompareCandidatesA2B[3, -1, 6, 10]", "Input"]
}, Open  ]]
},
FrontEndVersion->"13.0 for Mac OS X ARM (64-bit) (December 2, 2021)",
StyleDefinitions->"Default.nb"
]
