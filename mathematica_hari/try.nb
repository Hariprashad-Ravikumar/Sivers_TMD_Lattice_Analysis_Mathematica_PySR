       RowBox[{"Esigmasq", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"MakeErrBars", "[", 
               RowBox[{"{", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "E"}], "}"}], "}"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], ")"}], "^", "2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Osigmasq", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
