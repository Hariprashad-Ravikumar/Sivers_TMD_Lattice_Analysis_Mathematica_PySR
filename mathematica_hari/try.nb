           RowBox[{"[", "2", "]"}], "]"}], ")"}], "^", "2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sigmasqTotal", " ", "=", " ", 
        RowBox[{"Esigmasq", "+", "Osigmasq"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"OEsigmasq", " ", "=", " ", 
        RowBox[{"If", "[", 
