         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "DoF"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"chisquareperDoF", "=", 
        RowBox[{"chisquare", "/", 
