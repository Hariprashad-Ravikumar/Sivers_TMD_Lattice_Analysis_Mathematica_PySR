       "\[IndentingNewLine]", 
       RowBox[{"WeightList", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"\[CurlyEpsilon]", "=", 
           RowBox[{"10", "^", 
            RowBox[{"-", "6"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"\[Sigma]", "=", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
