               RowBox[{"\[Sigma]", ",", "\[CurlyEpsilon]"}], "]"}], "^", 
              "2"}]}]}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"ii", ",", " ", 
           RowBox[{"Length", "[", "xyJKf", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
