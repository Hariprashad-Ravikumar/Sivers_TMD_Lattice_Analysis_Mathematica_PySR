Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Define", " ", "a", " ", "function", " ", "to", " ", "generate",
     " ", "a", " ", "single", " ", "plot", " ", "dynamically"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"makePlot", "[", 
      RowBox[{"gVal_", ",", "part_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"vvectoranddata", "=", 
          RowBox[{"{", "}"}]}], ",", "v1data", ",", "blData", ",", 
         "groupSamev", ",", "averagedTableEvengPlusImForv", ",", 
         RowBox[{"dataforInterpolation", "=", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"v1dataforInterpolation", "=", 
          RowBox[{"{", "}"}]}], ",", "plotforinterpolation", ",", 
         "plotbeforinterpol", ",", "fninterpol", ",", "interpol0", ",", 
         "yLabelStr"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"v1data", "=", 
            RowBox[{"PathToShift", "[", 
             RowBox[{
              RowBox[{"vlinksv3", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", "3"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"blData", "=", 
            RowBox[{"MemDBGet", "[", 
             RowBox[{"platdb", ",", 
              RowBox[{"MemDBSelect", "[", 
               RowBox[{"platdb", ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"gammaValue", "->", "gVal"}], ",", 
                  RowBox[{"linkPath", "->", "linkPatheg"}], ",", 
                  RowBox[{"sideLink", "->", 
                   RowBox[{"vlinksv3", "[", 
