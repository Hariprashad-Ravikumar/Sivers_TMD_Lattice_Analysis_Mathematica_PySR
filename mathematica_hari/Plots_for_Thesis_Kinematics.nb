        RowBox[{"{", 
         RowBox[{"bL", ",", "bT"}], "}"}]}], "]"}], "//", "Union"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "Combine", " ", "everything", " ", "into", " ", "a", " ", 
     "single", " ", "plot"}], "*)"}], "\n", 
   RowBox[{"finalPlotCombined", "=", 
