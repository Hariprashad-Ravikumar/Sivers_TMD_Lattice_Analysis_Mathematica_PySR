           RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fninterpol", "=", 
         RowBox[{"Interpolation", "[", 
          RowBox[{"plotforinterpolation", ",", 
           RowBox[{"InterpolationOrder", "->", "2"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"interpol0", "=", 
