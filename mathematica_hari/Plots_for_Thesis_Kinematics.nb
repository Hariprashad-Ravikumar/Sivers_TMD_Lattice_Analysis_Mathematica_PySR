     "two", " ", 
     RowBox[{"elements", ":", 
      RowBox[{"#", "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "2"}], "]"}], "]"}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"paths3D", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"PathToLinks", "[", 
        RowBox[{"DistinctLinkPaths", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "DistinctLinkPaths", "]"}]}], "}"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"paths2D", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", "2"}], "]"}], "]"}], "&"}], ",", "paths3D", ",", 
       
       RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Retrieve", " ", "your", " ", "top", " ", "plot", " ", 
     "points"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bLbTlist", "=", 
     RowBox[{
      RowBox[{"MemDBGet", "[", 
       RowBox[{"AmpDB", ",", 
        RowBox[{"MemDBSelect", "[", 
         RowBox[{"AmpDB", ",", 
          RowBox[{"{", "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"bL", ",", "bT"}], "}"}]}], "]"}], "//", "Union"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "Combine", " ", "everything", " ", "into", " ", "a", " ", 
     "single", " ", "plot"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"finalPlotCombined", "=", 
    RowBox[{"Graphics", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"LAYER", " ", "1"}], ":", 
         RowBox[{"Background", " ", "paths", " ", 
          RowBox[{"(", 
