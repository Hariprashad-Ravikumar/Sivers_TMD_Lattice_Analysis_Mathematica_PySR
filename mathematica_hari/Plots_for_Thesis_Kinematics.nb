    RowBox[{
     RowBox[{
     "Wrapped", " ", "in", " ", "Module", " ", "to", " ", "keep", " ", 
      "variables", " ", "local", " ", "and", " ", "prevent", " ", "cross"}], 
     "-", "contamination"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"PathToLinks", "[", "sidelink_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
