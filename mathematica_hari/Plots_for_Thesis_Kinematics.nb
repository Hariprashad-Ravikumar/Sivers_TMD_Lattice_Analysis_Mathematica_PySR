                RowBox[{"{", 
                 RowBox[{"\"\<\[CapitalGamma]\>\"", ",", "\"\<(\>\"", ",", 
                  RowBox[{"ToString", "[", "gVal", "]"}], ",", "\"\<)\>\""}], 
                 "}"}], "]"}]}], "]"}], ",", "\"\<}\>\""}], "}"}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
