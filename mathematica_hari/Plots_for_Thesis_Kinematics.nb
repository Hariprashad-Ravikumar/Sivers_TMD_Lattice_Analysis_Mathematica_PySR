             RowBox[{"ULinkslist", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"ULinkslist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
