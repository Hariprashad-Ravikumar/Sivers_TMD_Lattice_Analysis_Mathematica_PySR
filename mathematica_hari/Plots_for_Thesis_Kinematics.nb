               RowBox[{
                RowBox[{"Length", "[", "values", "]"}], ">", "1"}], ",", 
               RowBox[{"{", 
                RowBox[{"coords", ",", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"Plus", "@@", "values"}], ")"}], "/", 
                  RowBox[{"Length", "[", "values", "]"}]}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"coords", ",", 
                 RowBox[{"First", "[", "values", "]"}]}], "}"}]}], "]"}]}], 
            "]"}], ",", "groupSamev"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"v1dataforInterpolation", ",", 
             RowBox[{
              RowBox[{"v1", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"averagedTableEvengPlusImForv", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "[", 
                RowBox[{"[", "3", "]"}], "]"}], "]"}], "-", 
              RowBox[{
               RowBox[{
                RowBox[{"averagedTableEvengPlusImForv", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"dataforInterpolation", ",", 
             RowBox[{
              RowBox[{"averagedTableEvengPlusImForv", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "averagedTableEvengPlusImForv", "]"}]}], 
           "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"plotforinterpolation", "=", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"v1dataforInterpolation", ",", "dataforInterpolation"}], 
           "}"}], "]"}]}], ";", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "plotforinterpolation", "]"}], "<", "3"}], 
