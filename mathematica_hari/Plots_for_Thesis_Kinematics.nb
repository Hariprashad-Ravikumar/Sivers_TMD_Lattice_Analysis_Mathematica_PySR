                  RowBox[{"numberFilter", "->", "part"}]}], "}"}]}], "]"}], 
              ",", "data"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"vvectoranddata", ",", 
             RowBox[{"{", 
              RowBox[{"v1data", ",", 
               RowBox[{"blData", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "vlinksv3", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"groupSamev", "=", 
         RowBox[{"GroupBy", "[", 
          RowBox[{"vvectoranddata", ",", 
           RowBox[{"First", "->", "Last"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"averagedTableEvengPlusImForv", "=", 
         RowBox[{"KeyValueMap", "[", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"coords", ",", "values"}], "}"}], ",", 
             RowBox[{"If", "[", 
