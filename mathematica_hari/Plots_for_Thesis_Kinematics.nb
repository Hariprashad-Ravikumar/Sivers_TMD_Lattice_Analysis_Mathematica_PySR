           RowBox[{"Length", "[", "sidelink", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "ULinkslist", "]"}], ";"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Generate", " ", "the", " ", "paths", " ", "and", " ", 
     "project", " ", "them", " ", "to", " ", "2", "D"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "We", " ", "map", " ", "over", " ", "the", " ", "3", "D", " ", "paths", 
