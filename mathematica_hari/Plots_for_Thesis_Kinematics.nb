          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"fninterpol", "[", "0", "]"}]}], "}"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"yLabelStr", "=", 
         RowBox[{"TraditionalForm", "[", 
