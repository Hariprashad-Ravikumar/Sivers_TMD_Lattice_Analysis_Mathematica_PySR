            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
RowBox[{
RowBox[{\"(\", 
RowBox[{
SubsuperscriptBox[
StyleBox[\"v\", \"TI\"], \"1\", 
RowBox[{
StyleBox[\"c\", \"TI\"], 
StyleBox[\"o\", \"TI\"], 
StyleBox[\"n\", \"TI\"], 
