Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Define", " ", "the", " ", "path", " ", "function"}], 
   "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Note", ":", 
    RowBox[{
     RowBox[{
     "Wrapped", " ", "in", " ", "Module", " ", "to", " ", "keep", " ", 
      "variables", " ", "local", " ", "and", " ", "prevent", " ", "cross"}], 
     "-", "contamination"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"PathToLinks", "[", "sidelink_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ULinkslist", "=", 
         RowBox[{"{", "}"}]}], ",", "linki"}], "}"}], ",", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"ULinkslist", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"linki", "=", 
           RowBox[{"sidelink", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"linki", "==", "1"}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"ULinkslist", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"ULinkslist", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "+", "1"}], ",", 
                RowBox[{
                 RowBox[{"ULinkslist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"ULinkslist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}], "]"}]}], "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"linki", "==", 
             RowBox[{"-", "1"}]}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"ULinkslist", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"ULinkslist", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ",", 
                RowBox[{
                 RowBox[{"ULinkslist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"ULinkslist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}], "]"}]}], "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"linki", "==", "2"}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"ULinkslist", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"ULinkslist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"ULinkslist", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "+", "1"}], ",", 
                RowBox[{
                 RowBox[{"ULinkslist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}], "]"}]}], "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"linki", "==", 
             RowBox[{"-", "2"}]}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"ULinkslist", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"ULinkslist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"ULinkslist", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", "1"}], ",", 
                RowBox[{
                 RowBox[{"ULinkslist", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}], "]"}]}], "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"linki", "==", "3"}], ",", 
