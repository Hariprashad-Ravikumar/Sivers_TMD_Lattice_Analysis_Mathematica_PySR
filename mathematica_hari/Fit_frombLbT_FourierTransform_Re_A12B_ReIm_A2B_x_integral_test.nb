       "\[IndentingNewLine]", 
       RowBox[{"sigmasqTotal", " ", "=", " ", 
        RowBox[{"Esigmasq", "+", "Osigmasq"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"OEsigmasq", " ", "=", " ", 
        RowBox[{"If", "[", 
