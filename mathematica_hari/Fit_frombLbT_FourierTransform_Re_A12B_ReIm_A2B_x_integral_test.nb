        "chisquareperDoF"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"numFs", "=", 
        RowBox[{"Length", "[", 
         RowBox[{"xyJKf", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "3"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WeightList", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"\[CurlyEpsilon]", "=", 
           RowBox[{"10", "^", 
            RowBox[{"-", "6"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"\[Sigma]", "=", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"MakeErrBars", "[", 
                 RowBox[{"{", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", 
                    RowBox[{
                    RowBox[{"xyJKf", "[", 
                    RowBox[{"[", "ii", "]"}], "]"}], "[", 
                    RowBox[{"[", "3", "]"}], "]"}]}], "}"}], "}"}], "]"}], 
                "[", 
                RowBox[{"[", "1", "]"}], "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], ")"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"WeightList", ",", 
            RowBox[{"1", "/", 
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"\[Sigma]", ",", "\[CurlyEpsilon]"}], "]"}], "^", 
              "2"}]}]}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"ii", ",", " ", 
           RowBox[{"Length", "[", "xyJKf", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Function", " ", "to", " ", "extract", " ", "j"}], "-", 
         RowBox[{
         "th", " ", "f", " ", "values", " ", "and", " ", "fit", " ", 
          "them"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"fitParamsForFj", "[", "j_", "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"data", ",", "fit"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"data", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"3", ",", "j"}], "]"}], "]"}]}], "}"}], "&"}], "/@",
              "xyJKf"}]}], ";", 
           RowBox[{"(*", 
            RowBox[{"Extract", " ", "f_j", " ", "values"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"fit", "=", 
            RowBox[{"NonlinearModelFit", "[", 
             RowBox[{"data", ",", "model", ",", "para", ",", "vari", ",", " ", 
              RowBox[{"Weights", "->", "WeightList"}], ",", 
              RowBox[{"Method", "->", 
               RowBox[{"{", "\"\<LevenbergMarquardt\>\"", "}"}]}]}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], " ", 
         RowBox[{"(*", 
          RowBox[{"Extract", " ", "fitted", " ", "parameters"}], "*)"}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
