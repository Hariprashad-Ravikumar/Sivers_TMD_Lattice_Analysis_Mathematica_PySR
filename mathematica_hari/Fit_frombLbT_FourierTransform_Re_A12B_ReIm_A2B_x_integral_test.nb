           RowBox[{"j", ",", "numFs"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"jackknifeResults", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"JacknifeSamples", "@@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"para", "[", 
