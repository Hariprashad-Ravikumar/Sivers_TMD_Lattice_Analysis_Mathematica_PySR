            ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"pa", ",", 
            RowBox[{"Length", "[", "para", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"DoF", "=", 
